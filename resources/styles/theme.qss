QPushButton {
    font-family: "Xolonium";
}

QListView {
    background-color: transparent;
}

QLineEdit[controlRole="input"] {
    border: 1px solid;
    selection-color: #FFFFFF;
    min-height: 20px;
    max-height: 20px;
}

QLineEdit[controlRole="input"][platform="macos"] {
    border-radius: 16px;
    padding: 5px 14px;
}

QLineEdit[controlRole="input"][platform="windows"] {
    border-radius: 4px;
    padding: 7px 12px;
}

QWidget[theme="dark"] QLineEdit[controlRole="input"] {
    color: #F5F5F7;
    placeholder-text-color: #A1A1AA;
    background-color: #2C2C2E;
    border-color: #545458;
    selection-background-color: #0A84FF;
}

QWidget[theme="light"] QLineEdit[controlRole="input"] {
    color: #1C1C1E;
    placeholder-text-color: #6E6E73;
    background-color: #FFFFFF;
    border-color: #C7C7CC;
    selection-background-color: #007AFF;
}

QWidget[theme="dark"] QLineEdit[controlRole="input"]:hover {
    border-color: #8E8E93;
}

QWidget[theme="light"] QLineEdit[controlRole="input"]:hover {
    border-color: #8E8E93;
}

QWidget[theme="dark"] QLineEdit[controlRole="input"]:focus {
    border-color: #0A84FF;
}

QWidget[theme="light"] QLineEdit[controlRole="input"]:focus {
    border-color: #007AFF;
}

QWidget[theme="dark"] QLineEdit[controlRole="input"]:disabled {
    color: #98989D;
    placeholder-text-color: #98989D;
    background-color: #242426;
    border-color: #3A3A3C;
}

QWidget[theme="light"] QLineEdit[controlRole="input"]:disabled {
    color: #8E8E93;
    placeholder-text-color: #8E8E93;
    background-color: #F2F2F7;
    border-color: #D1D1D6;
}
